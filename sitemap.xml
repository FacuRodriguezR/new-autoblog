// generate-sitemap.js
const fs = require('fs');

const baseUrl = 'https://blog.redautoshop.com.ar';
const staticRoutes = ['home', 'benefits', 'events', 'tips', 'mcdonalds'];

// Aquí deberías traer tus slugs de la base de datos/API
const dynamicSlugs = ['evento-1', 'tip-limpieza-quirurgica']; 

const sitemap = `<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  ${staticRoutes.map(route => `<url><loc>${baseUrl}/${route}</loc></url>`).join('')}
  ${dynamicSlugs.map(slug => `<url><loc>${baseUrl}/event/${slug}</loc></url>`).join('')}
</urlset>`;

fs.writeFileSync('./public/sitemap.xml', sitemap);